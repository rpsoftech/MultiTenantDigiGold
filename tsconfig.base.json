{
  "compilerOptions": {
    "composite": true,
    "declaration": false,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@digi-gold/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@dg/services": ["./packages/libs/shared-services/src/index.ts"],
      "@dg/angular-core": ["./packages/libs/angular-core/src/index.ts"],
      "@dg/ui": ["./packages/libs/shared-ui/src/index.ts"]
    }
  }
}
