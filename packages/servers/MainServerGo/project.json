{
  "name": "MainServerGo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "github.com/rpsoftech/DigiGold/MainServerGo",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -count=1 ./...",
        "cwd": "packages/servers/MainServerGo"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -tags=integration -count=1 -v ./internal/integration/...",
        "cwd": "packages/servers/MainServerGo"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ../dbtool migrate up",
        "cwd": "packages/servers/MainServerGo/cmd/api"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ../dbtool seed",
        "cwd": "packages/servers/MainServerGo/cmd/api"
      }
    }
  }
}
