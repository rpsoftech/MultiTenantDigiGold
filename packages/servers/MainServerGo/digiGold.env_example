# Copy to cmd/api/digiGold.env (API) and cmd/worker/digiGold.env (worker).
# Both files are git-ignored. Never commit real values.

# APP CONFIG
# One of: LOCAL, DEVELOP, CI, STAGING, PRODUCTION
# LOCAL/DEVELOP print routes on boot; LOCAL/DEVELOP/STAGING serve Swagger at /docs;
# STAGING/PRODUCTION enable the OTA self-updater.
APP_ENV="LOCAL"
PORT="8080"

# JWT SIGNING KEYS (required, at least 100 characters each, different from each other)
# Generate with: openssl rand -base64 96 | tr -d '\n'
ACCESS_TOKEN_KEY="replace-with-100+-random-characters"
REFRESH_TOKEN_KEY="replace-with-100+-random-characters"

# REDIS CONFIG
REDIS_DB_HOST="127.0.0.1"
REDIS_DB_PORT="6379"
# Required (must not be empty). Matches the password in docker-compose.yml.
REDIS_DB_PASSWORD="localredispass"
REDIS_DB_USERNAME=""
REDIS_DB_DATABASE="0"
# Prefix for app keys and event channels
REDIS_DEFAULT_KEY="digiGold:"
REDIS_DEFAULT_CHANNEL="digiGold:"

# POSTGRES CONFIG (PostgreSQL 18+, the schema uses uuidv7())
PG_HOST="127.0.0.1"
PG_PORT="5432"
PG_USERNAME="admin"
PG_PASSWORD="adminpassword"
PG_DATABASE="digigold_db"
PG_SCHEMA="public"

# OPENTELEMETRY (optional): OTLP gRPC collector for traces and metrics (Grafana)
# OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"

# CORS: comma-separated frontend origins allowed to call the API.
# Unset allows any origin ("*"), which is only meant for development; PRODUCTION refuses
# to start without it.
# CORS_ALLOW_ORIGINS="https://shop.example.com,https://admin.example.com"

# HEDGING (optional): no liquidity provider is integrated yet, so the hedging cron is off.
# "true" runs it with simulated fills for testing; it is ignored in PRODUCTION.
# ENABLE_MOCK_LP_HEDGING="false"

# BOOTSTRAP (dbtool bootstrap only, e.g. a new production database): the first super_admin.
# Set them for that one run and remove them afterwards.
# BOOTSTRAP_ADMIN_USERNAME="platform-root"
# BOOTSTRAP_ADMIN_PHONE="9000000001"
# BOOTSTRAP_ADMIN_PASSWORD="at-least-12-characters"
