{
	"info": {
		"name": "DigiGold Trade Endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Customer Buy",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "{{jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/trade/buy", "host": ["{{base_url}}"], "path": ["api", "v1", "trade", "buy"] },
				"body": {
					"mode": "raw",
					"raw": "{\n  \"requested_rate_per_gram\": 7000.0,\n  \"total_amount_inr\": 1000.0,\n  \"payment_mode\": \"ONLINE_PG\"\n}",
					"options": { "raw": { "language": "json" } }
				}
			}
		},
		{
			"name": "Customer Sell",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "{{jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/trade/sell", "host": ["{{base_url}}"], "path": ["api", "v1", "trade", "sell"] },
				"body": {
					"mode": "raw",
					"raw": "{\n  \"requested_rate_per_gram\": 6900.0,\n  \"weight_grams\": 1.0,\n  \"payment_mode\": \"ONLINE_PG\"\n}",
					"options": { "raw": { "language": "json" } }
				}
			}
		},
		{
			"name": "Customer History",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "{{jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/trade/history?page=1&limit=20", "host": ["{{base_url}}"], "path": ["api", "v1", "trade", "history"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
			}
		},
		{
			"name": "Customer Portfolio",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "{{jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/user/portfolio", "host": ["{{base_url}}"], "path": ["api", "v1", "user", "portfolio"] }
			}
		},
		{
			"name": "Admin Ledger",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "{{admin_jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/admin/store/ledger?page=1&limit=20", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "store", "ledger"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
			}
		},
		{
			"name": "Admin Customers",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "{{admin_jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/admin/store/customers?page=1&limit=20", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "store", "customers"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
			}
		},
		{
			"name": "Admin Counter Trade",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "{{admin_jwt_token}}" }
				],
				"url": { "raw": "{{base_url}}/api/v1/admin/store/trade/counter", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "store", "trade", "counter"] },
				"body": {
					"mode": "raw",
					"raw": "{\n  \"user_id\": 123,\n  \"requested_rate_per_gram\": 7000.0,\n  \"total_amount_inr\": 1000.0,\n  \"payment_mode\": \"COUNTER_CASH\",\n  \"action\": \"BUY\"\n}",
					"options": { "raw": { "language": "json" } }
				}
			}
		}
	]
}
