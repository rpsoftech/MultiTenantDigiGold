NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://digigold.rpso.in/api/v1
# The demo tenant `go run ./cmd/dbtool seed` creates (MainServerGo).
NEXT_PUBLIC_TENANT_UUID=01900000-0000-7000-8000-000000000002
NEXT_PUBLIC_DEFAULT_TENANT=aurelian-digital
NEXT_PUBLIC_USE_MOCK_AUTH=false
# Jewellery catalogue (nav link, home sections, /jewellery pages). Unset, it is on for
# `next dev` but off for `next build`, so a staging build that should show it needs `true`.
# Production keeps it off until MainServer has a catalogue API; see .env.production.example.
NEXT_PUBLIC_ENABLE_JEWELLERY=true
NEXT_PUBLIC_USE_MOCK_MARKETPLACE=true
NEXT_PUBLIC_USE_MOCK_MARKETPLACE_CATEGORY=true
# Admin panel uses MainServer store analytics, customers, and ledger by default.
# Set to true only for local sample data.
NEXT_PUBLIC_USE_MOCK_ADMIN=false
NEXT_PUBLIC_USE_MOCK_ADMIN_AUTH=false
NEXT_PUBLIC_USE_MOCK_MARKET=true
NEXT_PUBLIC_USE_MOCK_PORTFOLIO=false
# Razorpay Checkout needs no key here: MainServer returns the store's own public key with
# each order (POST /trade/buy/initiate → key_id).
