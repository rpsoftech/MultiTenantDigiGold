NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://digigold.rpso.in/api/v1
# The demo tenant `go run ./cmd/dbtool seed` creates (MainServerGo).
NEXT_PUBLIC_TENANT_UUID=01900000-0000-7000-8000-000000000002
NEXT_PUBLIC_DEFAULT_TENANT=aurelian-digital
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_MARKETPLACE=true
# Admin panel: sign-in is real (username + password + TOTP against MainServer) while the
# dashboard data is still mocked — so a successful login shows sample numbers, not this
# tenant's. Flip NEXT_PUBLIC_USE_MOCK_ADMIN once the admin data endpoints are wired.
NEXT_PUBLIC_USE_MOCK_ADMIN=true
NEXT_PUBLIC_USE_MOCK_ADMIN_AUTH=false
NEXT_PUBLIC_USE_MOCK_MARKET=true
NEXT_PUBLIC_USE_MOCK_PORTFOLIO=false
# Razorpay Checkout public key. NOTE: this is a single global key for the whole deployment,
# not per-tenant — a real multi-tenant rollout needs this served from tenant-safe config
# (e.g. GET /tenant/info) instead.
# Key ID only — the key secret belongs on MainServer, never in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
